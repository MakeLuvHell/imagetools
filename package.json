{
  "name": "imagetools",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run frontend:vendor",
    "frontend:vendor": "node scripts/sync_frontend_vendor.js",
    "test:ui": "python scripts/run_playwright_linux_env.py npx playwright test",
    "test:ui:update": "python scripts/run_playwright_linux_env.py npx playwright test --update-snapshots",
    "backend:bundle": "python scripts/bundle_backend.py",
    "desktop:dev": "node scripts/run_desktop_dev.js",
    "desktop:build": "npm run backend:bundle && tauri build",
    "desktop:build:windows": "npm run backend:bundle && tauri build --target x86_64-pc-windows-msvc --bundles nsis,msi"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "jsdom": "29.1.1",
    "lucide": "1.24.0"
  }
}
